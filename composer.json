{
    "name": "larena/core",
    "description": "Larena Core: Platform foundation for package registry, operation runtime, compatibility, SitePack portable data standard and shared contracts.",
    "type": "library",
    "license": "Apache-2.0",
    "authors": [
        {
            "name": "Rim Zabarov",
            "homepage": "https://github.com/zabarov"
        }
    ],
    "require": {
        "php": "^8.3",
        "illuminate/console": "^13.0",
        "illuminate/database": "^13.0",
        "illuminate/support": "^13.0",
        "symfony/yaml": "^7.4|^8.0"
    },
    "autoload": {
        "psr-4": {
            "Larena\\Core\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Larena\\Core\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Larena\\Core\\Providers\\CoreServiceProvider"
            ]
        }
    },
    "require-dev": {
        "larena/access": "dev-main",
        "larena/audit": "dev-main",
        "larena/licensing": "dev-main",
        "phpstan/phpstan": "^2.0"
    },
    "repositories": [
        {
            "type": "path",
            "url": "../access",
            "options": {
                "symlink": true
            }
        },
        {
            "type": "path",
            "url": "../auth",
            "options": {
                "symlink": true
            }
        },
        {
            "type": "path",
            "url": "../audit",
            "options": {
                "symlink": true
            }
        },
        {
            "type": "path",
            "url": "../dataview",
            "options": {
                "symlink": true
            }
        },
        {
            "type": "path",
            "url": "../layout",
            "options": {
                "symlink": true
            }
        },
        {
            "type": "path",
            "url": "../licensing",
            "options": {
                "symlink": true
            }
        },
        {
            "type": "path",
            "url": "../ui",
            "options": {
                "symlink": true
            }
        }
    ],
    "scripts": {
        "test": [
            "@php tests/Unit/OperationRuntimeContractTest.php",
            "@php -d zend.assertions=1 -d assert.exception=1 tests/Unit/CatalogOperationExecutionTest.php",
            "@php tests/Unit/OperationRuntimeFailsClosedTest.php",
            "@php tests/Unit/SyncOperationRuntimeTest.php",
            "@php tests/Unit/SyncOperationRuntimeFailsClosedTest.php",
            "@php tests/Unit/SyncOperationRuntimeTransactionBoundaryTest.php",
            "@php tests/Unit/RuntimeSecurityCompositionTest.php",
            "@php tests/Unit/RuntimeSecurityCompositionFailsClosedTest.php",
            "@php tests/Unit/FoundationPackageSetTest.php",
            "@php tests/Unit/InstallReadinessContractTest.php",
            "@php tests/Unit/InstallApplyLaunchRecordTest.php",
            "@php tests/Unit/PackageRegistrySeedTest.php",
            "@php tests/Unit/InstallerPersistenceFoundationTest.php",
            "@php tests/Unit/InstallerDbSchemaApplyTest.php",
            "@php tests/Unit/InstallAuditTrailApplyTest.php",
            "@php tests/Unit/PackageRegistryDiagnosticsTest.php",
            "@php tests/Unit/RuntimeSecurityClusterSmokeTest.php",
            "@php tests/Unit/DataContentClusterSmokeTest.php",
            "@php tests/Unit/CommandReportPresenterTest.php",
            "@php tests/Unit/StarterEvidencePathTest.php",
            "@php tests/Unit/CoreAssetActivationContractTest.php",
            "@php tests/Unit/VerifiedAssetBundlePublisherTest.php",
            "@php tests/Unit/FirstRunCoordinatorTest.php",
            "@php tests/Unit/FirstRunPreflightServiceTest.php",
            "@php tests/Unit/WebInstallStateStoreTest.php",
            "@php tests/Unit/WebInstallCoordinatorRecoveryTest.php",
            "@php tests/Unit/MinimalCmsDependencyContractTest.php",
            "@php tests/Unit/MinimalCmsCoreBoundaryTest.php",
            "@php tests/Unit/ScopeRefTest.php",
            "@php tests/Unit/ScopeRegistryTest.php",
            "@php tests/Unit/ScopeRegistryFailsClosedTest.php",
            "@php tests/Unit/PlaneRegistryTest.php",
            "@php tests/Unit/PlaneNodeMoveTest.php",
            "@php tests/Unit/PlaneNodeMoveFailsClosedTest.php",
            "@php tests/Unit/MembershipResolverTest.php",
            "@php tests/Unit/MembershipResolverDescendantsTest.php",
            "@php tests/Unit/ScopeBaselineInstallerIdempotencyTest.php",
            "@php tests/Unit/ScopePlaneAuditEventTest.php",
            "@php tests/Unit/OperationDescriptorRiskClassDefaultTest.php",
            "@php tests/Unit/OperationDeclarationLoaderTest.php",
            "@php tests/Unit/OperationDeclarationLoaderFailsClosedTest.php",
            "@php tests/Unit/DeclaredOperationRegistryTest.php",
            "@php tests/Unit/DescriptorPolicyTest.php",
            "@php tests/Unit/ConfirmationPolicyTest.php",
            "@php tests/Unit/ProposalAndApprovalTest.php",
            "@php tests/Unit/ProposalFailsClosedTest.php",
            "@php tests/Unit/TransportResolutionTest.php",
            "@php tests/Unit/TransportGateMatrixTest.php",
            "@php tests/Unit/PackageDescriptorFileValidatorTest.php",
            "@php tests/Unit/OperationCoverageReportTest.php",
            "@php tests/Unit/EnvironmentProfileTest.php",
            "@php tests/Unit/EnvironmentDetectionTest.php",
            "@php tests/Unit/EnvironmentVerificationTest.php",
            "@php tests/Unit/EnvironmentFailsClosedTest.php",
            "@php tests/Unit/SolutionManifestValidationTest.php",
            "@php tests/Unit/SolutionPlannerConflictTest.php",
            "@php tests/Unit/SolutionTopologyTest.php",
            "@php tests/Unit/SolutionFailsClosedTest.php"
        ],
        "test:unit": [
            "@php tests/Unit/OperationRuntimeContractTest.php",
            "@php -d zend.assertions=1 -d assert.exception=1 tests/Unit/CatalogOperationExecutionTest.php",
            "@php tests/Unit/OperationRuntimeFailsClosedTest.php",
            "@php tests/Unit/SyncOperationRuntimeTest.php",
            "@php tests/Unit/SyncOperationRuntimeFailsClosedTest.php",
            "@php tests/Unit/SyncOperationRuntimeTransactionBoundaryTest.php",
            "@php tests/Unit/RuntimeSecurityCompositionTest.php",
            "@php tests/Unit/RuntimeSecurityCompositionFailsClosedTest.php",
            "@php tests/Unit/FoundationPackageSetTest.php",
            "@php tests/Unit/InstallReadinessContractTest.php",
            "@php tests/Unit/InstallApplyLaunchRecordTest.php",
            "@php tests/Unit/PackageRegistrySeedTest.php",
            "@php tests/Unit/InstallerPersistenceFoundationTest.php",
            "@php tests/Unit/InstallerDbSchemaApplyTest.php",
            "@php tests/Unit/InstallAuditTrailApplyTest.php",
            "@php tests/Unit/PackageRegistryDiagnosticsTest.php",
            "@php tests/Unit/RuntimeSecurityClusterSmokeTest.php",
            "@php tests/Unit/DataContentClusterSmokeTest.php",
            "@php tests/Unit/CommandReportPresenterTest.php",
            "@php tests/Unit/StarterEvidencePathTest.php",
            "@php tests/Unit/CoreAssetActivationContractTest.php",
            "@php tests/Unit/VerifiedAssetBundlePublisherTest.php",
            "@php tests/Unit/FirstRunCoordinatorTest.php",
            "@php tests/Unit/FirstRunPreflightServiceTest.php",
            "@php tests/Unit/WebInstallStateStoreTest.php",
            "@php tests/Unit/WebInstallCoordinatorRecoveryTest.php",
            "@php tests/Unit/MinimalCmsDependencyContractTest.php",
            "@php tests/Unit/MinimalCmsCoreBoundaryTest.php"
        ],
        "lint": "@php scripts/lint.php",
        "analyse": "@php scripts/analyse.php",
        "validate:larena": "@php scripts/validate-larena-package.php",
        "evidence:check": "@php scripts/check-evidence.php",
        "scope:check": "@php tools/larena-scope-check.php",
        "quality:gate": [
            "@validate:larena",
            "@lint",
            "@analyse",
            "@test",
            "@larena:metadata:check",
            "@evidence:check",
            "@scope:check"
        ],
        "larena:metadata:check": "@php scripts/check-metadata-sync.php"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {},
        "platform": {
            "php": "8.3.0"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
