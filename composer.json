{
  "name": "larena/core",
  "description": "Larena Core package: platform contracts, operation runtime, package registry and shared foundation.",
  "type": "library",
  "license": "Apache-2.0",
  "authors": [
    {
      "name": "Rim Zabarov",
      "homepage": "https://github.com/zabarov"
    }
  ],
  "require": {
    "php": "^8.3"
  },
  "autoload": {
    "psr-4": {
      "Larena\\Core\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Larena\\Core\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "php scripts/test-placeholder.php",
    "test:unit": "php scripts/test-placeholder.php --unit",
    "lint": "php scripts/lint.php",
    "analyse": "php scripts/analyse.php",
    "validate:larena": "php scripts/validate-larena-package.php",
    "evidence:check": "php scripts/check-evidence.php"
  },
  "config": {
    "sort-packages": true,
    "allow-plugins": {}
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
